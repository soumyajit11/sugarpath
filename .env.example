# Local demo settings only. Do not place secrets in this file.
DEMO_MODE=true
DATABASE_URL=sqlite:///./sugar_path.db
APP_NAME=Sugar Path
# Browser origins allowed to call the local API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ollama is optional; leave its model blank to disable AI chat gracefully.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
MAX_TOOL_ITERATIONS=10
# Local medicine-event timing and synthetic glucose alert thresholds.
MEDICINE_MISSED_GRACE_MINUTES=60
MEDICINE_MORNING_DUE_HOUR=8
MEDICINE_EVENING_DUE_HOUR=20
GLUCOSE_LOW_THRESHOLD=70
GLUCOSE_HIGH_THRESHOLD=180
# Frontend API URL when running Vite outside Docker.
VITE_API_URL=http://127.0.0.1:8000
